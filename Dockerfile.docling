FROM python:3.11-slim

WORKDIR /app

# OS deps needed by Docling's image / OCR backends
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    docling \
    fastapi \
    "uvicorn[standard]" \
    spacy \
    pydantic \
    python-multipart

RUN python -m spacy download en_core_web_sm

# Pre-warm Docling models so the first /process request isn't a cold start.
RUN python -c "from docling.document_converter import DocumentConverter; DocumentConverter()"

COPY server_docling.py .

EXPOSE 8000

CMD ["uvicorn", "server_docling:app", "--host", "0.0.0.0", "--port", "8000"]
