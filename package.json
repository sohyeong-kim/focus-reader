{
  "name": "focus-reader",
  "version": "1.0.0",
  "description": "ADHD-friendly research paper reader with semantic chunking and Bionic Reading",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "python3 server_grobid_v2.py",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Focus Reader Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "build": {
    "appId": "com.focusreader.app",
    "productName": "Focus Reader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "focusread-v5.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "server_grobid_v2.py",
        "to": "server_grobid_v2.py"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "dmg": {
      "title": "Focus Reader",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  }
}
